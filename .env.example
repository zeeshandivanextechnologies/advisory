# Supabase project (Settings → API). Only the publishable key belongs here —
# never put the service_role key or DB password in a REACT_APP_ variable.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backend: "supabase" (serverless, default) or "express" (Node server in backend/)
REACT_APP_BACKEND=supabase
# Used only when REACT_APP_BACKEND=express
REACT_APP_API_URL=http://localhost:5000/api
