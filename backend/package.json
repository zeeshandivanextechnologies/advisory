  },
  "devDependencies": {
    "supabase": "^2.117.0"
  },
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0"
  },
  "main": "src/index.js"
}
