# ── Server ─────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (defaults to FRONTEND_URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Auth (this API's own login tokens) ────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Database (Supabase Postgres) ──────────────────────
# Dashboard → Connect → Direct connection (or Session pooler if IPv6 is unavailable)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Supabase (Auth + Storage) ─────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-side only. Needed for file upload/download and password changes.
SUPABASE_SERVICE_ROLE_KEY=

MAX_UPLOAD_MB=20

# ── Email (nodemailer / SMTP) ─────────────────────────
# Leave SMTP_HOST empty in development: emails (OTP codes, reset links) are printed to the console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<16-char App Password>
APP_NAME=AunAdvisory
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AunAdvisory <no-reply@yourdomain.com>"
# Receives contact-form inquiries (optional)
ADMIN_EMAIL=

# ── Online payments (Admin → Settings → Payment gateway = Stripe) ──
# Secret key: Stripe Dashboard → Developers → API keys. Webhook secret: from the
# webhook endpoint for POST <api>/payments/stripe/webhook (or `stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Session reminder emails 30 minutes before each session (checked every minute)
SESSION_REMINDERS=true
