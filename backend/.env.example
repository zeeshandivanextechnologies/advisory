# ── Server ─────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (defaults to FRONTEND_URL)
CORS_ORIGINS=http://localhost:3000

# ── Auth (this API's own login tokens) ────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Database (Supabase Postgres) ──────────────────────
# Dashboard → Connect → Direct connection (or Session pooler if IPv6 is unavailable)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Supabase (Auth + Storage) ─────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-side only. Needed for file upload/download and password changes.
SUPABASE_SERVICE_ROLE_KEY=

MAX_UPLOAD_MB=20
